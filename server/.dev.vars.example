# Server secrets. The "Deploy to Cloudflare" button asks for these values during deployment.
# Do not put real values in this file. Real values are set on Cloudflare, or in a local .dev.vars file.

# TOKEN_SECRET: a random string of at least 32 characters. Changing it later signs every device out.
TOKEN_SECRET=

# REGISTER_CODE: optional invite code, at least 12 characters. Leave empty to allow anyone to register (rate-limited).
REGISTER_CODE=
