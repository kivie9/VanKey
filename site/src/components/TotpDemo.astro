---
import type { Dict } from '../i18n/vi';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const SECRET = 'GEZD GNBV GY3T QOJQ GEZD GNBV GY3T QOJQ';
---

<section class="section" aria-labelledby="totp-title">
  <div class="wrap layout">
    <div data-reveal>
      <h2 id="totp-title"><span class="sec" data-rule><span data-decode>{t.totp.section}</span></span>{t.totp.title}</h2>
      <p class="lead">{t.totp.lead}</p>
      <p class="check">{t.totp.check}</p>
    </div>

    <div class="device" data-totp data-secret={SECRET} data-remaining={t.totp.remaining} data-unsupported={t.totp.unsupported}>
      <div class="row">
        <div class="meta">
          <p class="account">{t.totp.account}</p>
          <p class="label" data-decode>TOTP · SHA1 · 6 · 30s</p>
        </div>
        <!-- Hình tròn đếm ngược giống vòng trong app: một hình quạt, không có vạch. -->
        <svg class="ring" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle class="track" cx="12" cy="12" r="6" />
          <circle class="fill" data-fill cx="12" cy="12" r="6" />
        </svg>
      </div>
      <p class="code" data-code>––– –––</p>
      <p class="visually-hidden" data-status>{t.totp.codeLabel}</p>
      <p class="note" data-note><noscript>{t.totp.noJs}</noscript></p>
      <div class="secret">
        <p class="label">{t.totp.secretLabel}</p>
        <code>{SECRET}</code>
      </div>
    </div>
  </div>
</section>

<style>
  .layout { display: grid; gap: var(--space-12); align-items: center; }
  @media (min-width: 900px) {
    .layout { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
  }
  .check { margin-top: var(--space-6); font-size: var(--text-sm); color: var(--muted); max-width: 52ch; }

  .device {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 4vw, 32px);
    --ring: var(--accent);
    color: var(--fg);
  }
  .row { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4); }
  .account { font-weight: 600; }
  .meta { min-width: 0; }
  .meta .label { white-space: nowrap; }

  .ring { flex: none; width: 28px; height: 28px; transform: scaleX(-1); }
  .ring circle { fill: none; stroke-width: 12; }
  .ring .track { stroke: var(--line); }
  .ring .fill { stroke: var(--ring); transform: rotate(-90deg); transform-origin: 12px 12px; }

  .code {
    margin-top: var(--space-6);
    font: 600 clamp(2rem, 8vw, 2.75rem) / 1.1 var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--ring);
  }
  .device:global(.is-urgent) { --ring: var(--warn); }

  .note:empty { display: none; }
  .note { margin-top: var(--space-4); font-size: var(--text-sm); color: var(--muted); }

  .secret { margin-top: var(--space-8); padding-top: var(--space-4); border-top: 1px dashed var(--line); }
  .secret code { display: block; margin-top: var(--space-2); font-size: var(--text-sm); overflow-wrap: anywhere; color: var(--muted); }
</style>
