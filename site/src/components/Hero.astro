---
import logo from '../../../docs/brand/vankey-logo.svg?raw';
import type { Dict } from '../i18n/vi';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
// Ảnh tĩnh dự phòng dùng đúng hai đường nét của logo.
// Số hiệu bản: năm và tháng lúc build.
const rev = new Date().toISOString().slice(0, 7).replace('-', '.');
const [shield, v] = [...logo.matchAll(/<path d="([^"]+)"/g)].map((m) => m[1]);
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="stage wrap">
    <div class="copy">
      <p class="sheet" aria-hidden="true" data-rule><span data-decode>VanKey</span><span data-decode>{t.hero.sheet} · §1</span><span data-decode>Rev {rev}</span></p>
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="actions">
        <a class="button button-primary" href="#download">{t.hero.download}</a>
        <a class="button" href="#flow">{t.hero.how}</a>
      </p>
      <dl class="spec">
        {t.hero.spec.map((row) => (
          <div>
            <dt>{row.k}</dt>
            <dd data-decode>{row.v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="plate" aria-hidden="true">
      <div class="visual" data-hero-visual>
        <svg class="fallback" viewBox="55 46 70 90" focusable="false">
          <path d={shield} class="shield"></path>
          <path d={v} class="vee"></path>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; }
  .stage {
    display: grid;
    gap: var(--space-6);
    align-content: center;
    padding-block: var(--space-12);
  }
  h1 { font-size: var(--text-3xl); letter-spacing: -0.035em; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  /* Dòng đầu trang sổ: tên, loại tài liệu, số bản. */
  .sheet {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-4);
    padding-bottom: var(--space-2); margin-bottom: var(--space-8);
    position: relative;
    font: 600 var(--text-xs) / 1.4 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase;
  }
  .sheet span:nth-child(2) { color: var(--accent); }
  .sheet::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: var(--fg); transform-origin: left; }

  /* Bảng thông số thay cho dòng ghi chú. */
  .spec { margin: var(--space-8) 0 0; max-width: 460px; font: 400 var(--text-xs) / 1.4 var(--font-mono); }
  .spec div { display: flex; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-2); border-top: 1px dashed var(--line); }
  .spec div:last-child { border-bottom: 1px dashed var(--line); }
  .spec dt { color: var(--muted); }
  .spec dd { margin: 0; color: var(--fg); text-align: right; }

  /* Khung hình có dấu góc như ảnh dán vào sổ. */
  .plate { position: relative; display: grid; grid-template-rows: minmax(0, 1fr); min-height: 0; padding: var(--space-3); }
  .plate::before, .plate::after {
    content: ''; position: absolute; z-index: 1; width: 18px; height: 18px; pointer-events: none;
    border-color: var(--muted); border-style: solid;
  }
  .plate::before { top: 0; left: 0; border-width: 1.5px 0 0 1.5px; }
  .plate::after { right: 0; bottom: 0; border-width: 0 1.5px 1.5px 0; }
  .visual { position: relative; width: 100%; height: 320px; min-height: 0; }
  .fallback { position: absolute; inset: 6% 0; width: 100%; height: 88%; }
  .shield { fill: var(--accent); opacity: 0.9; }
  .vee { fill: none; stroke: var(--page); stroke-width: 10; stroke-linecap: round; stroke-linejoin: round; }
  .visual :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; }
  .hero:global(.is-live) .visual :global(canvas) { opacity: 1; }

  @media (min-width: 900px) {
    .stage { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: center; min-height: min(760px, calc(100svh - 64px)); }
    .visual { height: min(560px, 72svh); }
  }

  /* Có JS và người xem không tắt chuyển động: chờ canvas thay cho ảnh tĩnh. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .fallback { opacity: 0; }
    .hero:global(.is-static) .fallback { opacity: 1; }
    .hero:global(.is-live) .fallback { opacity: 0; }
    .visual :global(canvas) { transition: opacity 0.5s ease; }
  }

  /* Đủ chỗ thì giữ hero đứng yên trong lúc cuộn để các hạt ráp lại. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) and (min-width: 900px) and (min-height: 620px),
    (scripting: enabled) and (prefers-reduced-motion: no-preference) and (max-width: 899px) and (min-height: 760px) {
    .hero { height: 185svh; }
    .stage { position: sticky; top: 64px; height: calc(100svh - 64px); min-height: 0; padding-block: var(--space-6); }
    .hero:global(.is-static) { height: auto; }
    .hero:global(.is-static) .stage { position: static; height: auto; }
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) and (max-width: 899px) and (min-height: 760px) {
    .stage { grid-template-rows: auto minmax(0, 1fr); align-content: stretch; }
    .plate, .visual { height: 100%; }
  }
</style>
