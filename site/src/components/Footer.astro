---
import { REPO } from '../config';
import type { Dict } from '../i18n/vi';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const legal = t.lang === 'vi'
  ? { terms: '/dieu-khoan/', privacy: '/quyen-rieng-tu/', deleteAccount: '/xoa-tai-khoan/', security: '/bao-mat/' }
  : { terms: '/en/terms/', privacy: '/en/privacy/', deleteAccount: '/en/delete-account/', security: '/en/security/' };
---

<footer data-rule>
  <div class="wrap">
    <p><strong>VanKey</strong>. {t.footer.tagline}</p>
    <p class="links">
      <a href={REPO}>GitHub</a>
      <a href={`${REPO}/tree/main/docs`}>{t.footer.docs}</a>
      <a href={legal.terms}>{t.footer.terms}</a>
      <a href={legal.privacy}>{t.footer.privacy}</a>
      <a href={legal.deleteAccount}>{t.footer.deleteAccount}</a>
      <a href={legal.security}>{t.footer.security}</a>
    </p>
    <p class="label">{t.footer.icons}</p>
  </div>
</footer>

<style>
  /* Đường kẻ đậm đóng trang sổ, giống dòng đầu trang ở hero. */
  footer { position: relative; width: min(100% - 2 * var(--gutter), var(--wrap)); margin-inline: auto; padding-block: var(--space-12); font-size: var(--text-sm); }
  footer::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1.5px; background: var(--fg); transform-origin: left; }
  footer .wrap { width: 100%; }
  .links { display: flex; flex-wrap: wrap; column-gap: var(--space-6); margin-block: var(--space-3); }
  .links a { display: inline-block; padding-block: var(--space-2); }
</style>
